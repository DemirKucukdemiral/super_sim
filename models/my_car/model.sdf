<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="my_car">
    <static>false</static>

    <!-- ========================================== -->
    <!-- BASE CHASSIS (Sprung Mass)                 -->
    <!-- ========================================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.0 0 0.12 0 0 0</pose>
        <mass>1350.0</mass>
        <inertia>
          <ixx>500.0</ixx>
          <iyy>2400.0</iyy>
          <izz>2700.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://my_car/meshes/car_body_aligned.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="body_collision">
        <pose>0.3 0 0.35 0 0 0</pose>
        <geometry>
          <box>
            <size>4.8 1.95 1.15</size>
          </box>
        </geometry>
      </collision>

      <!-- ======================================== -->
      <!-- 3D LiDAR (32-beam 360-degree GPU LiDAR)  -->
      <!-- ======================================== -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <pose>0.35 0 1.20 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.28</min_angle>
              <max_angle>0.26</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>my_car/lidar/points</topic>
      </sensor>

      <!-- ======================================== -->
      <!-- RGB-D CAMERA (Forward Vision & Depth)    -->
      <!-- ======================================== -->
      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0.80 0 0.95 0 0.05 0</pose>
        <camera>
          <horizontal_fov>1.5707963</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>80.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>my_car/camera</topic>
      </sensor>

      <!-- ======================================== -->
      <!-- IMU SENSOR (Chassis 6-DOF Dynamics)      -->
      <!-- ======================================== -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.12 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>my_car/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ========================================== -->
    <!-- FRONT LEFT STEERING KNUCKLE & WHEEL        -->
    <!-- ========================================== -->
    <link name="steer_knuckle_front_left">
      <pose>1.5416 0.92825 0 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="steer_front_left" type="revolute">
      <parent>base_link</parent>
      <child>steer_knuckle_front_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.65</lower>
          <upper>0.65</upper>
          <effort>1000000</effort>
          <velocity>10.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="wheel_front_left">
      <pose>1.5416 0.92825 0 0 0 0</pose>
      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>1.8</ixx>
          <iyy>3.2</iyy>
          <izz>1.8</izz>
        </inertia>
      </inertial>
      <visual name="visual_wheel_front_left">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://my_car/meshes/wheel_fl_aligned.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision_wheel_front_left">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.56985</radius>
            <length>0.35</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.3</mu>
              <mu2>1.3</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.005</slip1>
              <slip2>0.005</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e7</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
        </surface>

      </collision>
    </link>
    <joint name="wheel_front_left_spin" type="revolute">
      <parent>steer_knuckle_front_left</parent>
      <child>wheel_front_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ========================================== -->
    <!-- FRONT RIGHT STEERING KNUCKLE & WHEEL       -->
    <!-- ========================================== -->
    <link name="steer_knuckle_front_right">
      <pose>1.5416 -0.92825 0 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="steer_front_right" type="revolute">
      <parent>base_link</parent>
      <child>steer_knuckle_front_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.65</lower>
          <upper>0.65</upper>
          <effort>1000000</effort>
          <velocity>10.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="wheel_front_right">
      <pose>1.5416 -0.92825 0 0 0 0</pose>
      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>1.8</ixx>
          <iyy>3.2</iyy>
          <izz>1.8</izz>
        </inertia>
      </inertial>
      <visual name="visual_wheel_front_right">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://my_car/meshes/wheel_fr_aligned.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision_wheel_front_right">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.56985</radius>
            <length>0.35</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.3</mu>
              <mu2>1.3</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.005</slip1>
              <slip2>0.005</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e7</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
        </surface>

      </collision>
    </link>
    <joint name="wheel_front_right_spin" type="revolute">
      <parent>steer_knuckle_front_right</parent>
      <child>wheel_front_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ========================================== -->
    <!-- REAR LEFT WHEEL                            -->
    <!-- ========================================== -->
    <link name="wheel_rear_left">
      <pose>-1.5416 0.92825 0 0 0 0</pose>
      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>1.8</ixx>
          <iyy>3.2</iyy>
          <izz>1.8</izz>
        </inertia>
      </inertial>
      <visual name="visual_wheel_rear_left">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://my_car/meshes/wheel_rl_aligned.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision_wheel_rear_left">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.56985</radius>
            <length>0.35</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.3</mu>
              <mu2>1.3</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.005</slip1>
              <slip2>0.005</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e7</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
        </surface>

      </collision>
    </link>
    <joint name="wheel_rear_left_spin" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ========================================== -->
    <!-- REAR RIGHT WHEEL                           -->
    <!-- ========================================== -->
    <link name="wheel_rear_right">
      <pose>-1.5416 -0.92825 0 0 0 0</pose>
      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>1.8</ixx>
          <iyy>3.2</iyy>
          <izz>1.8</izz>
        </inertia>
      </inertial>
      <visual name="visual_wheel_rear_right">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://my_car/meshes/wheel_rr_aligned.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision_wheel_rear_right">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.56985</radius>
            <length>0.35</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.3</mu>
              <mu2>1.3</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.005</slip1>
              <slip2>0.005</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e7</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
        </surface>

      </collision>
    </link>
    <joint name="wheel_rear_right_spin" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ========================================== -->
    <!-- GAZEBO ACTUATOR SYSTEM PLUGINS             -->
    <!-- ========================================== -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_left_spin</joint_name>
      <topic>my_car/spin_fl_cmd</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_right_spin</joint_name>
      <topic>my_car/spin_fr_cmd</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_left_spin</joint_name>
      <topic>my_car/spin_rl_cmd</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_right_spin</joint_name>
      <topic>my_car/spin_rr_cmd</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>steer_front_left</joint_name>
      <topic>my_car/steer_fl_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>40.0</p_gain>
      <d_gain>1.5</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>steer_front_right</joint_name>
      <topic>my_car/steer_fr_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>40.0</p_gain>
      <d_gain>1.5</d_gain>
    </plugin>
  </model>
</sdf>
