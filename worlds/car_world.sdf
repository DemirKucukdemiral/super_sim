<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="car_world">

    <!-- Chase Camera: rigidly locked behind my_car -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.8 0 2.6 0 0.18 0</pose>
        <track_visual>
          <name>my_car</name>
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-5.8 0 2.1</xyz>
          <inherit_yaw>true</inherit_yaw>
        </track_visual>
      </camera>
    </gui>

    <physics name="10ms" type="ignored">
      <max_step_size>0.010</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    
    <scene>
      <ambient>0.6 0.6 0.65 1</ambient>
      <background>0.65 0.78 0.92 1</background>
      <grid>false</grid>
    </scene>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 80 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <!-- Ground Plane (Covers entire region so car can never fall through void) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3000 3000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.34 1</ambient>
            <diffuse>0.42 0.46 0.40 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- ============================================== -->
    <!-- CITY ROAD NETWORK (Avenues, Streets, Sidewalks)-->
    <!-- ============================================== -->
    <model name="city_roads">
      <static>true</static>
