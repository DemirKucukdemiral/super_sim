<?xml version="1.0" ?>

<sdf version="1.8">

  <world name="uav_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>


    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>

    </light>


    <!-- Ground -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- Our UAV -->

    <include>

      <uri>
        model://my_uav
      </uri>

      <pose>
        0 0 2 0 0 0
      </pose>

    </include>

  </world>

</sdf>
