<?xml version="1.0"?>
<robot name="my_car">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://super_sim_dynamics/models/my_car/meshes/car_body_aligned.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.3 0 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="4.8 1.95 1.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0 0.12" rpy="0 0 0"/>
      <mass value="1350.0"/>
      <inertia ixx="500.0" ixy="0.0" ixz="0.0" iyy="2400.0" iyz="0.0" izz="2700.0"/>
    </inertial>
  </link>

  <!-- Base footprint at ground level (REP-120) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.56985" rpy="0 0 0"/>
  </joint>

  <!-- Sensors Frames -->
  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.35 0 1.20" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.80 0 0.95" rpy="0 0.05 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Front Left Steering and Wheel -->
  <link name="steer_knuckle_front_left">
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="steer_front_left" type="revolute">
    <parent link="base_link"/>
    <child link="steer_knuckle_front_left"/>
    <origin xyz="1.5416 0.92825 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.65" upper="0.65" effort="1000" velocity="5"/>
  </joint>

  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://super_sim_dynamics/models/my_car/meshes/wheel_fl_aligned.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.56985" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="28.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="3.2" iyz="0" izz="1.8"/>
    </inertial>
  </link>
  <joint name="wheel_front_left_spin" type="continuous">
    <parent link="steer_knuckle_front_left"/>
    <child link="wheel_front_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right Steering and Wheel -->
  <link name="steer_knuckle_front_right">
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="steer_front_right" type="revolute">
    <parent link="base_link"/>
    <child link="steer_knuckle_front_right"/>
    <origin xyz="1.5416 -0.92825 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.65" upper="0.65" effort="1000" velocity="5"/>
  </joint>

  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://super_sim_dynamics/models/my_car/meshes/wheel_fr_aligned.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.56985" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="28.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="3.2" iyz="0" izz="1.8"/>
    </inertial>
  </link>
  <joint name="wheel_front_right_spin" type="continuous">
    <parent link="steer_knuckle_front_right"/>
    <child link="wheel_front_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="wheel_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://super_sim_dynamics/models/my_car/meshes/wheel_rl_aligned.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.56985" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="28.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="3.2" iyz="0" izz="1.8"/>
    </inertial>
  </link>
  <joint name="wheel_rear_left_spin" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-1.5416 0.92825 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="wheel_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://super_sim_dynamics/models/my_car/meshes/wheel_rr_aligned.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.56985" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="28.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="3.2" iyz="0" izz="1.8"/>
    </inertial>
  </link>
  <joint name="wheel_rear_right_spin" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-1.5416 -0.92825 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
